{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch",
      "dependsOn": ["watch:esbuild", "watch:tsc"],
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "watch:esbuild",
      "type": "shell",
      "command": "pnpm run watch",
      "isBackground": true,
      // Inline matcher: does not depend on any third-party extension.
      // Begin/end patterns match the lines printed by the plugin in esbuild.js.
      "problemMatcher": {
        "owner": "esbuild",
        "source": "esbuild",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": [
          { "regexp": "^\\[ERROR\\] (.*)$", "message": 1 },
          { "regexp": "^\\s+(.+):(\\d+):(\\d+):$", "file": 1, "line": 2, "column": 3 }
        ],
        "background": {
          "activeBegins": true,
          "beginsPattern": "^\\[watch\\] build started",
          "endsPattern": "^\\[watch\\] build finished"
        }
      },
      "presentation": { "group": "watch", "reveal": "never" },
      "group": "build"
    },
    {
      "label": "watch:tsc",
      "type": "shell",
      "command": "pnpm run watch:tsc",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "presentation": { "group": "watch", "reveal": "never" },
      "group": "build"
    },
    {
      "label": "compile",
      "type": "shell",
      "command": "pnpm run compile",
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "silent" },
      "group": "build"
    }
  ]
}
