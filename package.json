{
  "name": "git-pilot-ext",
  "displayName": "Git Pilot",
  "description": "Manage the current branch's GitLab or GitHub Issue, MR/PR labels, and status sync right from VS Code.",
  "version": "1.1.0",
  "publisher": "Granevsky",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/granevsky/git-pilot"
  },
  "bugs": {
    "url": "https://github.com/granevsky/git-pilot/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "gitlab",
    "github",
    "labels",
    "issues",
    "merge request",
    "pull request"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git",
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Git Pilot sends your API tokens to the host from the repository remote and reads settings from the workspace, so it only runs in trusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "gitPilot.setToken",
        "title": "Set Personal Access Token",
        "category": "Git Pilot",
        "icon": "$(key)"
      },
      {
        "command": "gitPilot.openInBrowser",
        "title": "Open Issue / MR in Browser",
        "category": "Git Pilot",
        "icon": "$(link-external)"
      },
      {
        "command": "gitPilot.selectRepository",
        "title": "Select Repository…",
        "category": "Git Pilot",
        "icon": "$(repo)"
      },
      {
        "command": "gitPilot.labelSync.selectStatus",
        "title": "Change Status…",
        "category": "Git Pilot",
        "icon": "$(tag)"
      },
      {
        "command": "gitPilot.labelSync.syncFromMr",
        "title": "Labels: Sync from MR / PR…",
        "category": "Git Pilot",
        "icon": "$(sync)"
      },
      {
        "command": "gitPilot.labelSync.refresh",
        "title": "Labels: Refresh",
        "category": "Git Pilot",
        "icon": "$(refresh)"
      },
      {
        "command": "gitPilot.openItem",
        "title": "Open in Browser",
        "category": "Git Pilot",
        "icon": "$(link-external)"
      },
      {
        "command": "gitPilot.labelSync.applyStatus",
        "title": "Apply Status",
        "category": "Git Pilot",
        "icon": "$(check)"
      },
      {
        "command": "gitPilot.labelSync.copyLabelName",
        "title": "Copy Label Name",
        "category": "Git Pilot",
        "icon": "$(copy)"
      },
      {
        "command": "gitPilot.labelSync.addLabel",
        "title": "Add Labels…",
        "category": "Git Pilot",
        "icon": "$(add)"
      },
      {
        "command": "gitPilot.labelSync.removeLabel",
        "title": "Remove Label from Issue / MR",
        "category": "Git Pilot",
        "icon": "$(close)"
      },
      {
        "command": "gitPilot.labelSync.replaceLabel",
        "title": "Replace Label…",
        "category": "Git Pilot",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitPilot.labelSync.copyLabelToOthers",
        "title": "Add Label Where Missing",
        "category": "Git Pilot",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitPilot.comments.refresh",
        "title": "Comments: Refresh",
        "category": "Git Pilot",
        "icon": "$(refresh)"
      },
      {
        "command": "gitPilot.comments.add",
        "title": "Comments: Add Comment…",
        "category": "Git Pilot",
        "icon": "$(comment)"
      },
      {
        "command": "gitPilot.comments.send",
        "title": "Comments: Send Comment",
        "category": "Git Pilot",
        "icon": "$(send)"
      },
      {
        "command": "gitPilot.comments.open",
        "title": "Read Comment",
        "category": "Git Pilot",
        "icon": "$(book)"
      },
      {
        "command": "gitPilot.comments.loadMore",
        "title": "Show More Comments",
        "category": "Git Pilot",
        "icon": "$(chevron-down)"
      }
    ],
    "keybindings": [
      {
        "command": "gitPilot.comments.send",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "gitPilot.comments.composer && editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitPilot",
          "title": "Git Pilot",
          "icon": "media/git-pilot.svg"
        }
      ]
    },
    "views": {
      "gitPilot": [
        {
          "id": "gitPilot.labelSync",
          "name": "Labels",
          "icon": "$(tag)",
          "contextualTitle": "Git Pilot"
        },
        {
          "id": "gitPilot.comments",
          "name": "Comments",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Git Pilot"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "gitPilot.openItem",
          "when": "false"
        },
        {
          "command": "gitPilot.labelSync.applyStatus",
          "when": "false"
        },
        {
          "command": "gitPilot.labelSync.removeLabel",
          "when": "false"
        },
        {
          "command": "gitPilot.labelSync.replaceLabel",
          "when": "false"
        },
        {
          "command": "gitPilot.labelSync.copyLabelToOthers",
          "when": "false"
        },
        {
          "command": "gitPilot.labelSync.copyLabelName",
          "when": "false"
        },
        {
          "command": "gitPilot.comments.send",
          "when": "gitPilot.comments.composer"
        },
        {
          "command": "gitPilot.comments.open",
          "when": "false"
        },
        {
          "command": "gitPilot.comments.loadMore",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "gitPilot.comments.send",
          "when": "gitPilot.comments.composer",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "gitPilot.comments.add",
          "when": "view == gitPilot.comments",
          "group": "navigation@1"
        },
        {
          "command": "gitPilot.comments.refresh",
          "when": "view == gitPilot.comments",
          "group": "navigation@2"
        },
        {
          "command": "gitPilot.labelSync.selectStatus",
          "when": "view == gitPilot.labelSync",
          "group": "navigation@1"
        },
        {
          "command": "gitPilot.labelSync.addLabel",
          "when": "view == gitPilot.labelSync",
          "group": "navigation@2"
        },
        {
          "command": "gitPilot.labelSync.syncFromMr",
          "when": "view == gitPilot.labelSync",
          "group": "navigation@3"
        },
        {
          "command": "gitPilot.labelSync.refresh",
          "when": "view == gitPilot.labelSync",
          "group": "navigation@4"
        },
        {
          "command": "gitPilot.openInBrowser",
          "when": "view =~ /^gitPilot[.]/",
          "group": "1_links@1"
        },
        {
          "command": "gitPilot.selectRepository",
          "when": "view =~ /^gitPilot[.]/",
          "group": "1_links@2"
        },
        {
          "command": "gitPilot.setToken",
          "when": "view =~ /^gitPilot[.]/",
          "group": "2_auth@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gitPilot.comments.add",
          "when": "view == gitPilot.comments && viewItem =~ /commentTarget/",
          "group": "inline@1"
        },
        {
          "command": "gitPilot.comments.add",
          "when": "view == gitPilot.comments && viewItem =~ /commentTarget/",
          "group": "1_comment@1"
        },
        {
          "command": "gitPilot.comments.open",
          "when": "view == gitPilot.comments && viewItem =~ /commentItem/",
          "group": "1_comment@1"
        },
        {
          "command": "gitPilot.labelSync.syncFromMr",
          "when": "view == gitPilot.labelSync && viewItem =~ /outOfSync/",
          "group": "inline@0"
        },
        {
          "command": "gitPilot.labelSync.syncFromMr",
          "when": "view == gitPilot.labelSync && viewItem =~ /outOfSync/",
          "group": "1_status@0"
        },
        {
          "command": "gitPilot.labelSync.selectStatus",
          "when": "view == gitPilot.labelSync && viewItem =~ /summary|entityStatus/",
          "group": "inline@1"
        },
        {
          "command": "gitPilot.labelSync.selectStatus",
          "when": "view == gitPilot.labelSync && viewItem =~ /summary|entityStatus/",
          "group": "1_status@1"
        },
        {
          "command": "gitPilot.labelSync.addLabel",
          "when": "view == gitPilot.labelSync && viewItem =~ /issueOrMr/",
          "group": "inline@1"
        },
        {
          "command": "gitPilot.labelSync.addLabel",
          "when": "view == gitPilot.labelSync && viewItem =~ /issueOrMr/",
          "group": "2_labels@1"
        },
        {
          "command": "gitPilot.openItem",
          "when": "view =~ /^gitPilot[.]/ && viewItem =~ /openable/",
          "group": "inline@9"
        },
        {
          "command": "gitPilot.openItem",
          "when": "view =~ /^gitPilot[.]/ && viewItem =~ /openable/",
          "group": "9_open@1"
        },
        {
          "command": "gitPilot.labelSync.copyLabelToOthers",
          "when": "view == gitPilot.labelSync && viewItem =~ /entityLabel/ && viewItem =~ /missingElsewhere/",
          "group": "inline@1"
        },
        {
          "command": "gitPilot.labelSync.replaceLabel",
          "when": "view == gitPilot.labelSync && viewItem =~ /entityLabel/ && viewItem =~ /grouped/",
          "group": "inline@2"
        },
        {
          "command": "gitPilot.labelSync.removeLabel",
          "when": "view == gitPilot.labelSync && viewItem =~ /entityLabel/",
          "group": "inline@3"
        },
        {
          "command": "gitPilot.labelSync.copyLabelToOthers",
          "when": "view == gitPilot.labelSync && viewItem =~ /entityLabel/ && viewItem =~ /missingElsewhere/",
          "group": "2_labels@1"
        },
        {
          "command": "gitPilot.labelSync.replaceLabel",
          "when": "view == gitPilot.labelSync && viewItem =~ /entityLabel/ && viewItem =~ /grouped/",
          "group": "2_labels@2"
        },
        {
          "command": "gitPilot.labelSync.removeLabel",
          "when": "view == gitPilot.labelSync && viewItem =~ /entityLabel/",
          "group": "2_labels@3"
        },
        {
          "command": "gitPilot.labelSync.addLabel",
          "when": "view == gitPilot.labelSync && viewItem =~ /canAdd/",
          "group": "inline@1"
        },
        {
          "command": "gitPilot.labelSync.removeLabel",
          "when": "view == gitPilot.labelSync && viewItem =~ /canRemove/",
          "group": "inline@2"
        },
        {
          "command": "gitPilot.labelSync.addLabel",
          "when": "view == gitPilot.labelSync && viewItem =~ /canAdd/",
          "group": "1_labels@1"
        },
        {
          "command": "gitPilot.labelSync.removeLabel",
          "when": "view == gitPilot.labelSync && viewItem =~ /canRemove/",
          "group": "1_labels@2"
        },
        {
          "command": "gitPilot.labelSync.applyStatus",
          "when": "view == gitPilot.labelSync && viewItem == statusLabel",
          "group": "inline@1"
        },
        {
          "command": "gitPilot.labelSync.applyStatus",
          "when": "view == gitPilot.labelSync && viewItem == statusLabel",
          "group": "1_labels@1"
        },
        {
          "command": "gitPilot.labelSync.copyLabelName",
          "when": "view =~ /^gitPilot[.]/ && viewItem =~ /catalogLabel|statusLabel|entityLabel|entityStatus/",
          "group": "9_copy@1"
        }
      ]
    },
    "configuration": [
      {
        "title": "Git Pilot",
        "properties": {
          "gitPilot.provider": {
            "type": "string",
            "enum": [
              "auto",
              "gitlab",
              "github"
            ],
            "enumDescriptions": [
              "Infer the platform from the git remote host.",
              "Force GitLab (use for self-hosted GitLab instances).",
              "Force GitHub (use for GitHub Enterprise Server)."
            ],
            "default": "auto",
            "description": "Which hosting platform the repository lives on."
          },
          "gitPilot.instanceUrl": {
            "type": "string",
            "default": "",
            "markdownDescription": "Optional base URL override for self-hosted GitLab or GitHub Enterprise, e.g. `https://gitlab.company.com`. Leave empty to derive it from the `origin` remote.",
            "scope": "machine"
          },
          "gitPilot.branchIssueRegex": {
            "type": "string",
            "default": "(?:^|/|-)(\\d+)(?:-|_|$)",
            "markdownDescription": "Regular expression applied to the current branch name. The **first capturing group** must contain the Issue IID / number (e.g. `142-fix-auth`, `feat/142-login`)."
          },
          "gitPilot.allowInsecureHttp": {
            "type": "boolean",
            "default": false,
            "scope": "machine",
            "markdownDescription": "Allow sending API tokens over plain `http://` (e.g. an internal GitLab without TLS). **Not recommended:** anyone on the network path can read the token. Workspace settings cannot enable this."
          }
        }
      },
      {
        "title": "Labels",
        "properties": {
          "gitPilot.labelSync.showStatusBar": {
            "type": "boolean",
            "default": true,
            "description": "Show the Issue / MR status item in the status bar."
          },
          "gitPilot.labelSync.labelPrefix": {
            "type": "string",
            "default": "status:",
            "markdownDescription": "Prefix identifying status labels. Use `status:` for regular labels or `status::` for GitLab Premium scoped labels. `:` and `::` variants are treated as equivalent when stripping old statuses."
          },
          "gitPilot.labelSync.refreshInterval": {
            "type": "number",
            "default": 120,
            "minimum": 0,
            "markdownDescription": "Interval in seconds for refreshing the Issue / MR data in the background while the window is focused (`0` disables it; minimum 10). Read-only: labels are changed only by your own actions, e.g. **Sync Labels from MR / PR…**, which asks for confirmation."
          },
          "gitPilot.labels.groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "maxItems": 50,
            "markdownDescription": "Masks that group labels, in display order, e.g. `[\"status:*\", \"app:*\", \"type:*\"]`. `*` matches any characters, `?` one character; `:` also matches `::` (scoped labels). Labels of one group are mutually exclusive on an Issue/MR (adding one replaces the other); labels that match no mask go to **Other** and can be combined. Leave empty to group automatically by the prefix before `:` / `::`."
          }
        }
      },
      {
        "title": "Comments",
        "properties": {
          "gitPilot.comments.compose": {
            "type": "string",
            "enum": [
              "quick",
              "editor"
            ],
            "enumDescriptions": [
              "A one-line input box: Enter posts the comment; a button in it moves the text to an editor for longer, multi-line Markdown.",
              "Always open a Markdown draft in an editor; post it with Ctrl+Enter (⌘+Enter on macOS) or the Send button."
            ],
            "default": "quick",
            "description": "How Add comment… collects the text of a new comment."
          },
          "gitPilot.comments.pageSize": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "maximum": 50,
            "markdownDescription": "How many comments the **Comments** section loads at a time (newest first); **Show more…** loads the next page. On GitLab the count is approximate, because automatic system notes are skipped after loading."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "pnpm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && node esbuild.js --production",
    "vscode:prepublish": "pnpm run package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b"
}