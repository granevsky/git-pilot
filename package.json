{
  "name": "git-pilot-ext",
  "displayName": "Git Pilot",
  "description": "Manage the current branch's GitLab or GitHub Issue, MR/PR labels, and status sync right from VS Code.",
  "version": "1.0.4",
  "publisher": "Granevsky",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/granevsky/git-pilot"
  },
  "bugs": {
    "url": "https://github.com/granevsky/git-pilot/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "gitlab",
    "github",
    "labels",
    "issues",
    "merge request",
    "pull request"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git",
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Git Pilot sends your API tokens to the host from the repository remote and reads settings from the workspace, so it only runs in trusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "gitPilot.setToken",
        "title": "Set Personal Access Token",
        "category": "Git Pilot",
        "icon": "$(key)"
      },
      {
        "command": "gitPilot.openInBrowser",
        "title": "Open Issue / MR in Browser",
        "category": "Git Pilot",
        "icon": "$(link-external)"
      },
      {
        "command": "gitPilot.statusSync.selectStatus",
        "title": "Change Status…",
        "category": "Git Pilot",
        "icon": "$(tag)"
      },
      {
        "command": "gitPilot.statusSync.syncFromMr",
        "title": "Issue & MR: Sync Labels from MR / PR…",
        "category": "Git Pilot",
        "icon": "$(sync)"
      },
      {
        "command": "gitPilot.statusSync.refresh",
        "title": "Issue & MR: Refresh",
        "category": "Git Pilot",
        "icon": "$(refresh)"
      },
      {
        "command": "gitPilot.openItem",
        "title": "Open in Browser",
        "category": "Git Pilot",
        "icon": "$(link-external)"
      },
      {
        "command": "gitPilot.statusSync.applyStatus",
        "title": "Apply Status",
        "category": "Git Pilot",
        "icon": "$(check)"
      },
      {
        "command": "gitPilot.labels.refresh",
        "title": "Labels: Refresh",
        "category": "Git Pilot",
        "icon": "$(refresh)"
      },
      {
        "command": "gitPilot.labels.copyName",
        "title": "Copy Label Name",
        "category": "Git Pilot",
        "icon": "$(copy)"
      },
      {
        "command": "gitPilot.statusSync.addLabel",
        "title": "Add Labels…",
        "category": "Git Pilot",
        "icon": "$(add)"
      },
      {
        "command": "gitPilot.statusSync.removeLabel",
        "title": "Remove Label from Issue / MR",
        "category": "Git Pilot",
        "icon": "$(close)"
      },
      {
        "command": "gitPilot.statusSync.replaceLabel",
        "title": "Replace Label…",
        "category": "Git Pilot",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitPilot.statusSync.copyLabelToOthers",
        "title": "Add Label Where Missing",
        "category": "Git Pilot",
        "icon": "$(arrow-right)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitPilot",
          "title": "Git Pilot",
          "icon": "media/git-pilot.svg"
        }
      ]
    },
    "views": {
      "gitPilot": [
        {
          "id": "gitPilot.statusSync",
          "name": "Issue & MR",
          "icon": "$(issues)",
          "contextualTitle": "Git Pilot",
          "when": "config.gitPilot.statusSync.showSection || !config.gitPilot.labels.enabled"
        },
        {
          "id": "gitPilot.labels",
          "name": "Labels",
          "icon": "$(tag)",
          "contextualTitle": "Git Pilot",
          "when": "config.gitPilot.labels.enabled"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "gitPilot.openItem",
          "when": "false"
        },
        {
          "command": "gitPilot.statusSync.applyStatus",
          "when": "false"
        },
        {
          "command": "gitPilot.statusSync.removeLabel",
          "when": "false"
        },
        {
          "command": "gitPilot.statusSync.replaceLabel",
          "when": "false"
        },
        {
          "command": "gitPilot.statusSync.copyLabelToOthers",
          "when": "false"
        },
        {
          "command": "gitPilot.labels.copyName",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "gitPilot.statusSync.selectStatus",
          "when": "view == gitPilot.statusSync",
          "group": "navigation@1"
        },
        {
          "command": "gitPilot.statusSync.addLabel",
          "when": "view == gitPilot.statusSync",
          "group": "navigation@2"
        },
        {
          "command": "gitPilot.statusSync.syncFromMr",
          "when": "view == gitPilot.statusSync",
          "group": "navigation@3"
        },
        {
          "command": "gitPilot.statusSync.refresh",
          "when": "view == gitPilot.statusSync",
          "group": "navigation@4"
        },
        {
          "command": "gitPilot.labels.refresh",
          "when": "view == gitPilot.labels",
          "group": "navigation@1"
        },
        {
          "command": "gitPilot.openInBrowser",
          "when": "view =~ /^gitPilot[.]/",
          "group": "1_links@1"
        },
        {
          "command": "gitPilot.setToken",
          "when": "view =~ /^gitPilot[.]/",
          "group": "2_auth@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gitPilot.statusSync.syncFromMr",
          "when": "view == gitPilot.statusSync && viewItem =~ /outOfSync/",
          "group": "inline@0"
        },
        {
          "command": "gitPilot.statusSync.syncFromMr",
          "when": "view == gitPilot.statusSync && viewItem =~ /outOfSync/",
          "group": "1_status@0"
        },
        {
          "command": "gitPilot.statusSync.selectStatus",
          "when": "view == gitPilot.statusSync && viewItem =~ /summary|entityStatus/",
          "group": "inline@1"
        },
        {
          "command": "gitPilot.statusSync.selectStatus",
          "when": "view == gitPilot.statusSync && viewItem =~ /summary|entityStatus/",
          "group": "1_status@1"
        },
        {
          "command": "gitPilot.statusSync.applyStatus",
          "when": "view == gitPilot.statusSync && viewItem == statusOption",
          "group": "inline@1"
        },
        {
          "command": "gitPilot.statusSync.applyStatus",
          "when": "view == gitPilot.statusSync && viewItem == statusOption",
          "group": "1_status@2"
        },
        {
          "command": "gitPilot.statusSync.addLabel",
          "when": "view == gitPilot.statusSync && viewItem =~ /issueOrMr/",
          "group": "inline@1"
        },
        {
          "command": "gitPilot.statusSync.addLabel",
          "when": "view == gitPilot.statusSync && viewItem =~ /issueOrMr/",
          "group": "2_labels@1"
        },
        {
          "command": "gitPilot.openItem",
          "when": "view =~ /^gitPilot[.]/ && viewItem =~ /openable/",
          "group": "inline@9"
        },
        {
          "command": "gitPilot.openItem",
          "when": "view =~ /^gitPilot[.]/ && viewItem =~ /openable/",
          "group": "9_open@1"
        },
        {
          "command": "gitPilot.statusSync.copyLabelToOthers",
          "when": "view == gitPilot.statusSync && viewItem =~ /entityLabel/ && viewItem =~ /missingElsewhere/",
          "group": "inline@1"
        },
        {
          "command": "gitPilot.statusSync.replaceLabel",
          "when": "view == gitPilot.statusSync && viewItem =~ /entityLabel/ && viewItem =~ /grouped/",
          "group": "inline@2"
        },
        {
          "command": "gitPilot.statusSync.removeLabel",
          "when": "view == gitPilot.statusSync && viewItem =~ /entityLabel/",
          "group": "inline@3"
        },
        {
          "command": "gitPilot.statusSync.copyLabelToOthers",
          "when": "view == gitPilot.statusSync && viewItem =~ /entityLabel/ && viewItem =~ /missingElsewhere/",
          "group": "2_labels@1"
        },
        {
          "command": "gitPilot.statusSync.replaceLabel",
          "when": "view == gitPilot.statusSync && viewItem =~ /entityLabel/ && viewItem =~ /grouped/",
          "group": "2_labels@2"
        },
        {
          "command": "gitPilot.statusSync.removeLabel",
          "when": "view == gitPilot.statusSync && viewItem =~ /entityLabel/",
          "group": "2_labels@3"
        },
        {
          "command": "gitPilot.statusSync.addLabel",
          "when": "view == gitPilot.labels && viewItem =~ /canAdd/",
          "group": "inline@1"
        },
        {
          "command": "gitPilot.statusSync.removeLabel",
          "when": "view == gitPilot.labels && viewItem =~ /canRemove/",
          "group": "inline@2"
        },
        {
          "command": "gitPilot.statusSync.addLabel",
          "when": "view == gitPilot.labels && viewItem =~ /canAdd/",
          "group": "1_labels@1"
        },
        {
          "command": "gitPilot.statusSync.removeLabel",
          "when": "view == gitPilot.labels && viewItem =~ /canRemove/",
          "group": "1_labels@2"
        },
        {
          "command": "gitPilot.statusSync.applyStatus",
          "when": "view == gitPilot.labels && viewItem == statusLabel",
          "group": "inline@1"
        },
        {
          "command": "gitPilot.statusSync.applyStatus",
          "when": "view == gitPilot.labels && viewItem == statusLabel",
          "group": "1_labels@1"
        },
        {
          "command": "gitPilot.labels.copyName",
          "when": "view =~ /^gitPilot[.]/ && viewItem =~ /catalogLabel|statusLabel|entityLabel|entityStatus|statusOption/",
          "group": "9_copy@1"
        }
      ]
    },
    "configuration": [
      {
        "title": "Git Pilot",
        "properties": {
          "gitPilot.provider": {
            "type": "string",
            "enum": [
              "auto",
              "gitlab",
              "github"
            ],
            "enumDescriptions": [
              "Infer the platform from the git remote host.",
              "Force GitLab (use for self-hosted GitLab instances).",
              "Force GitHub (use for GitHub Enterprise Server)."
            ],
            "default": "auto",
            "description": "Which hosting platform the repository lives on."
          },
          "gitPilot.instanceUrl": {
            "type": "string",
            "default": "",
            "markdownDescription": "Optional base URL override for self-hosted GitLab or GitHub Enterprise, e.g. `https://gitlab.company.com`. Leave empty to derive it from the `origin` remote.",
            "scope": "machine"
          },
          "gitPilot.branchIssueRegex": {
            "type": "string",
            "default": "(?:^|/|-)(\\d+)(?:-|_|$)",
            "markdownDescription": "Regular expression applied to the current branch name. The **first capturing group** must contain the Issue IID / number (e.g. `142-fix-auth`, `feat/142-login`)."
          },
          "gitPilot.allowInsecureHttp": {
            "type": "boolean",
            "default": false,
            "scope": "machine",
            "markdownDescription": "Allow sending API tokens over plain `http://` (e.g. an internal GitLab without TLS). **Not recommended:** anyone on the network path can read the token. Workspace settings cannot enable this."
          }
        }
      },
      {
        "title": "Issue & MR",
        "properties": {
          "gitPilot.statusSync.showSection": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Show the **Issue & MR** section in the Git Pilot sidebar. Ignored while it is the only section (i.e. `gitPilot.labels.enabled` is off): then it is always shown."
          },
          "gitPilot.statusSync.showStatusBar": {
            "type": "boolean",
            "default": true,
            "description": "Show the Issue / MR status item in the status bar."
          },
          "gitPilot.statusSync.labelPrefix": {
            "type": "string",
            "default": "status:",
            "markdownDescription": "Prefix identifying status labels. Use `status:` for regular labels or `status::` for GitLab Premium scoped labels. `:` and `::` variants are treated as equivalent when stripping old statuses."
          },
          "gitPilot.statusSync.refreshInterval": {
            "type": "number",
            "default": 120,
            "minimum": 0,
            "markdownDescription": "Interval in seconds for refreshing the Issue / MR data in the background while the window is focused (`0` disables it; minimum 10). Read-only: labels are changed only by your own actions, e.g. **Sync Labels from MR / PR…**, which asks for confirmation."
          }
        }
      },
      {
        "title": "Labels",
        "properties": {
          "gitPilot.labels.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Show the Labels section (project label catalog) in the Git Pilot sidebar."
          },
          "gitPilot.labels.groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "maxItems": 50,
            "markdownDescription": "Masks that group labels, in display order, e.g. `[\"status:*\", \"app:*\", \"type:*\"]`. `*` matches any characters, `?` one character; `:` also matches `::` (scoped labels). Labels of one group are mutually exclusive on an Issue/MR (adding one replaces the other); labels that match no mask go to **Other** and can be combined. Leave empty to group automatically by the prefix before `:` / `::`."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "pnpm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && node esbuild.js --production",
    "vscode:prepublish": "pnpm run package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b"
}